DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wase_workflow

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

RECEIPT_VERIFY_API_BASE=https://links.et
RECEIPT_VERIFY_ENDPOINT=/api/verify-image
RECEIPT_VERIFY_API_KEY=your_links_verify_api_key
RECEIPT_VERIFY_TIMEOUT_MS=60000

# JWT Token Expiration
ACCESS_TOKEN_TTL=7d
RESET_TOKEN_TTL=15d

# Bcrypt Hashing Cost (recommended: 10-12 for development, 12+ for production)
BCRYPT_COST=12

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Frontend URL (for password reset link)
FRONTEND_URL=http://localhost:5173

# Telegram Sender Configuration (my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org
