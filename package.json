{
  "name": "wase-workflow-backend",
  "version": "1.0.0",
  "description": "Workflow Management System - Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/app.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/data-source.ts",
    "telegram:login": "ts-node src/modules/telegram/login.ts",
    "test:telegram": "ts-node src/tests/telegram-sender.test.ts",
    "test:role-payment": "ts-node src/tests/role-payment.test.ts",
    "test:payment": "ts-node src/tests/payment-expiration.test.ts",
    "test:bank-response": "ts-node src/tests/bank-response.test.ts",
    "test:event-registration": "ts-node src/tests/event-registration.test.ts",
    "test:user-profile-image": "ts-node src/tests/user-profile-image.test.ts",
    "test:otp": "ts-node src/tests/otp-verification.test.ts",
    "test:google-auth": "ts-node src/tests/google-auth.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "telegram": "^2.26.22",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
